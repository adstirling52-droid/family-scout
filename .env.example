# Copy to .env for a local send. Do not commit .env.
# GitHub Actions reads RESEND_API_KEY from a repository secret instead.

# Send-only key from https://resend.com/api-keys
# Sign up with Alan@alanstirling.com so the free test sender can deliver there.
RESEND_API_KEY=

# Optional. Defaults to Alan@alanstirling.com
PLANNER_TO=Alan@alanstirling.com

# Optional. Leave unset until alanstirling.com is verified in Resend.
# SMTP_FROM=weekend@alanstirling.com
